# Copy to .env and fill in values. Never commit .env to git.

# Gemini API key (VITE_ prefix is required for client exposure via Vite)
# Legacy names GEMINI_API_KEY / CUSTOM_GEMINI_API_KEY are also read at build time.
VITE_GEMINI_API_KEY=
VITE_CUSTOM_GEMINI_API_KEY=
GEMINI_API_KEY=
CUSTOM_GEMINI_API_KEY=

# Mapillary access token
VITE_MAPILLARY_ACCESS_TOKEN=
MAPILLARY_ACCESS_TOKEN=

# Optional site gate — password stays in .env only; only a SHA-256 hash is embedded in the build.
ENABLE_SITE_PASSWORD=false
SITE_PASSWORD=
